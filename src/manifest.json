{
  "manifest_version": 3,
  "name": "GTA 6 Spoiler Shield",
  "version": "1.1.1",
  "description": "Blurs or hides anything about GTA 6 across the web so you can avoid spoilers.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "GTA 6 Spoiler Shield",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "common.js",
        "content.js"
      ],
      "css": [
        "shield.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
